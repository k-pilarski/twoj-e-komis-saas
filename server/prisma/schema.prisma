// 1. Konfiguracja połączenia

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 2. Model Użytkownika (Właściciel Komisu)

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  password         String   // Zaszyfrowane hasło
  firstName        String?
  lastName         String?
  
  isSubscribed     Boolean  @default(false)
  subscriptionId   String?  // Identyfikator płatności
  
  tenant           Tenant?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// 3. Tabela Komisu

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique // np. "auto-handel-mirek"

  status    AccountStatus @default(PENDING)
  expiresAt DateTime?

  ownerId     String   @unique
  owner       User     @relation(fields: [ownerId], references: [id])

  vehicles  Vehicle[]
  settings  Settings?

  createdAt   DateTime @default(now())
}

// 3. Tabela Samochodów (Inwentarz)

model Vehicle {
  id                  String   @id @default(uuid())
  tenantId            String   // Klucz obcy
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Podstawowe
  brand               String
  model               String
  year                Int
  price               Float
  description         String?

  // Identyfikacja i historia
  vin                 String?
  licensePlate        String?
  firstRegistration   String?  // Format YYYY-MM-DD
  mileage             Int?     // Przebieg w kilometrach

  // Specyfikacja techniczna
  fuelType            String?  // np. Benzyna, Diesel, Hybryda, Elektryczny
  engineCapacity      Int?     // Pojemność w cm3
  enginePower         Int?     // Moc w KM
  transmission        String?  // Manualna, Automatyczna
  drivetrain          String?  // Na przednie, Na tylne, 4x4
  bodyType            String?  // Sedan, Kombi, SUV itp.
  color               String?
  doors               Int?
  seats               Int?

  // Stan i pochodzenie
  isDamaged           Boolean  @default(false)
  isImported          Boolean  @default(false)
  importedFrom        String?  // Kraj pochodzenia, jeśli isImported = true

  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt
}

// 5. Model Ustawień Kreatora

model Settings {
  id               String   @id @default(uuid())
  
  // Wygląd (np. 1 z 5 kolorów, 1 z 3 układów)
  primaryColor     String   @default("#2563eb")
  layoutType       String   @default("GRID") // np. GRID, LIST, MINIMAL
  fontStyle        String   @default("SANS")
  
  // Wybrane podstrony (Checkboxy z kreatora)
  hasContactPage     Boolean  @default(true)
  hasRegulationsPage Boolean  @default(false)
  
  // Dane kontaktowe na stronę wygenerowaną
  phoneNumber      String?
  address          String?

  tenantId         String   @unique
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
}

// 6. Typy wyliczeniowe (Enum)

enum AccountStatus {
  PENDING   // Świeżo zarejestrowany, czeka na opłacenie faktury
  ACTIVE    // Opłacony, ma dostęp do kreatora i panelu
  EXPIRED   // Czas minął lub brak płatności
}